# Native MPS kernels, with optional captured Qwen xModel package integration.
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_OBJCXX_STANDARD 17)
set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
find_library(GARNET_METAL_FRAMEWORK Metal REQUIRED)
find_library(GARNET_MPS_FRAMEWORK MetalPerformanceShaders REQUIRED)
find_library(GARNET_FOUNDATION_FRAMEWORK Foundation REQUIRED)
add_library(garnet_metal STATIC src/backends/metal/metal_context.mm)
option(GARNET_METAL_RESIDENT_KV_INPLACE "Write only new token slots in private resident decode caches" OFF)
if(GARNET_METAL_RESIDENT_KV_INPLACE)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_RESIDENT_KV_INPLACE=1)
endif()

option(GARNET_METAL_SMALL_OUTPUT_DECODE "Use two-output 64-thread decode groups for at most 256 outputs" OFF)
if(GARNET_METAL_SMALL_OUTPUT_DECODE)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_SMALL_OUTPUT_DECODE=1)
endif()
option(GARNET_METAL_EXACT_HALF_PREFILL "Test exact scaled FP16 storage for mixed FP32 MPS prefill" OFF)
if(GARNET_METAL_EXACT_HALF_PREFILL)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_EXACT_HALF_PREFILL=1)
endif()
option(GARNET_METAL_JOINED_PREFILL "Test bounded exact-half joined body prefill projections" OFF)
if(GARNET_METAL_JOINED_PREFILL)
    if(NOT GARNET_METAL_EXACT_HALF_PREFILL)
        message(FATAL_ERROR "Joined prefill requires exact-half prefill")
    endif()
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_JOINED_PREFILL=1)
endif()
option(GARNET_METAL_MPS_VISION_SCORES "Test FP32 batched MPS vision attention scores" OFF)
if(GARNET_METAL_MPS_VISION_SCORES)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_MPS_VISION_SCORES=1)
endif()
option(GARNET_METAL_FUSED_VISION_CONTEXT "Test FP32 softmax and value contraction in one kernel" OFF)
if(GARNET_METAL_FUSED_VISION_CONTEXT)
    if(NOT GARNET_METAL_MPS_VISION_SCORES)
        message(FATAL_ERROR "Fused vision context requires MPS vision scores")
    endif()
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_FUSED_VISION_CONTEXT=1)
endif()
option(GARNET_METAL_ATTENTION_PREFIX "Test GPU-verified contiguous prompt slot lookup" OFF)
if(GARNET_METAL_ATTENTION_PREFIX)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_ATTENTION_PREFIX=1)
endif()
option(GARNET_METAL_PARALLEL_DELTA_SPLIT "Test parallel FP32 recurrent dot reductions" OFF)
if(GARNET_METAL_PARALLEL_DELTA_SPLIT)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_PARALLEL_DELTA_SPLIT=1)
endif()
option(GARNET_METAL_FLOAT_DENSE_KEY_PREFILL "Test FP32 split-K dense key projections during prefill" OFF)
if(GARNET_METAL_FLOAT_DENSE_KEY_PREFILL)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_FLOAT_DENSE_KEY_PREFILL=1)
endif()
option(GARNET_METAL_LINEAR_CHUNK_DIRECT_WRITE "Write recurrent chunk outputs directly into final token slots" OFF)
if(GARNET_METAL_LINEAR_CHUNK_DIRECT_WRITE)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_LINEAR_CHUNK_DIRECT_WRITE=1)
endif()
option(GARNET_METAL_LINEAR_CHUNK_CONV "Process causal convolution and preparation across a prompt chunk" OFF)
if(GARNET_METAL_LINEAR_CHUNK_CONV)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_LINEAR_CHUNK_CONV=1)
endif()
option(GARNET_METAL_LINEAR_CHUNK_DELTA "Keep recurrent delta state in registers across a prompt chunk" OFF)
if(GARNET_METAL_LINEAR_CHUNK_DELTA)
    if(NOT GARNET_METAL_LINEAR_CHUNK_CONV OR NOT GARNET_METAL_PARALLEL_DELTA_SPLIT)
        message(FATAL_ERROR "Chunk delta requires chunk convolution and parallel delta split")
    endif()
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_LINEAR_CHUNK_DELTA=1)
endif()
option(GARNET_METAL_QWEN35_EXTENDED_PREFILL "Validate Qwen3.5 prefill chunks up to 80 tokens" OFF)
if(GARNET_METAL_QWEN35_EXTENDED_PREFILL)
    if(NOT GARNET_METAL_LINEAR_CHUNK_CONV OR NOT GARNET_METAL_LINEAR_CHUNK_DELTA OR NOT GARNET_METAL_PARALLEL_DELTA_SPLIT)
        message(FATAL_ERROR "Extended Qwen3.5 prefill requires retained convolution/delta chunk kernels")
    endif()
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_QWEN35_EXTENDED_PREFILL=1)
endif()
target_include_directories(garnet_metal PUBLIC src/backends/metal)
target_compile_options(garnet_metal PRIVATE -fobjc-arc)
target_link_libraries(garnet_metal PUBLIC
    "${GARNET_METAL_FRAMEWORK}" "${GARNET_MPS_FRAMEWORK}"
    "${GARNET_FOUNDATION_FRAMEWORK}")
enable_testing()
add_executable(garnet_metal_matmul_test test2026/metal/matmul_test.cpp)
target_link_libraries(garnet_metal_matmul_test PRIVATE garnet_metal)
add_test(NAME metal_mps_matmul_reference COMMAND garnet_metal_matmul_test)
if(GARNET_METAL_JOINED_PREFILL)
    add_executable(garnet_joined_prefill_test test2026/metal/joined_prefill_test.cpp)
    target_link_libraries(garnet_joined_prefill_test PRIVATE garnet_metal)
    add_test(NAME metal_joined_prefill_reference COMMAND garnet_joined_prefill_test)
endif()
option(GARNET_METAL_XMODEL "Build the native XLang3 Metal package" OFF)
if(GARNET_METAL_XMODEL)
    set(XLANG3_SDK_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../xlang3/sdk" CACHE PATH "Public XLang3 SDK")
    set(GARNET_XLANG3_RUNTIME_LIBRARY "" CACHE FILEPATH "Existing XLang3 shared runtime")
    if(NOT EXISTS "${XLANG3_SDK_ROOT}/xlang3/xlang3.h" OR NOT EXISTS "${GARNET_XLANG3_RUNTIME_LIBRARY}")
        message(FATAL_ERROR "Metal xModel requires the SDK and shared XLang3 runtime")
    endif()
    set_target_properties(garnet_metal PROPERTIES POSITION_INDEPENDENT_CODE ON)
    add_library(garnet SHARED src/entry/metal_main.cpp src/backends/metal/compiled_graph.cpp
        src/backends/metal/decoder_session.cpp
        src/tensor/garnet_tensor.cpp src/tensor/graph_capture.cpp src/core/lowering_context.cpp
        src/model/safetensors_index.cpp src/tokenizer/qwen_tokenizer.cpp)
    target_include_directories(garnet PRIVATE "${XLANG3_SDK_ROOT}" src/tensor src/core src/model src/tokenizer src/backends/cpu src/backends/metal third_party)
    target_compile_definitions(garnet PRIVATE GARNET_WITH_METAL=1 XLANG3_USE_SHARED=1)
    target_link_libraries(garnet PRIVATE garnet_metal "${GARNET_XLANG3_RUNTIME_LIBRARY}")
endif()

# Experimental decode-only native BF16 body route; default control unchanged.
option(GARNET_METAL_NATIVE_BFLOAT_BODY "Test native BF16 serial/dot body projections" OFF)
if(GARNET_METAL_NATIVE_BFLOAT_BODY)
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_NATIVE_BFLOAT_BODY=1)
endif()
