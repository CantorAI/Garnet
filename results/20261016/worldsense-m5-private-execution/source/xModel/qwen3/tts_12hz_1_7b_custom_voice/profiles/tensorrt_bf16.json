{
  "schema_version": 1,
  "id": "tensorrt-bf16",
  "backend": "tensorrt",
  "device": "CUDA",
  "precision": "bf16",
  "entrypoint": "prefill",
  "runtime_options": {
    "audio_sample_rate": 24000,
    "codec_frame_rate": 12.5,
    "codec_groups": 16,
    "max_audio_frames_env": "GARNET_TTS_MAX_FRAMES",
    "default_max_audio_frames": 256
  },
  "capabilities": {
    "single_request_generation": true,
    "audio_output": true,
    "custom_voice": true,
    "instruction_control": true
  }
}
