+X::Value GarnetVLMFilter::BenchmarkCurrentFrame(X::Value candidate) {
+    // Same Skill perception/verification path, without delivery, persistence or
+    // WorldState writes. Current-only admission prevents history-dependent
+    // state from changing a fixed-input optimization experiment.
+    if (!candidate.IsDict() || !Has(candidate, "event_evaluation") ||
+        candidate.Get("event_evaluation").ToString() != "current" ||
+        !Has(candidate, "jpeg") || !HasSearchImage(candidate.Get("jpeg")))
+        throw X::Error("Benchmark requires an image and current-frame evaluation");
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_initialized) {
+        if (m_Params.IsDict() && Has(m_Params, "maxOutputTokens"))
+            m_maxOutputTokens = static_cast<int>((std::max)(std::int64_t{32}, m_Params.Get("maxOutputTokens").ToInt64()));
+        InitializeGarnet();
+        m_initialized = true;
+    }
+    EnsureGarnetModel();
+    m_framePerceptions.clear();
+    Request request{candidate, X::Value::Dict(Host()), 0};
+    X::Value result = Infer(request, false);
+    m_framePerceptions.clear();
+    return result;
+}
