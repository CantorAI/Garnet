+class BenchmarkFrame(BaseModel):
+    observation_id: str = Field(min_length=1, max_length=200)
+    skill_ref: str = Field(min_length=1, max_length=1024)
+    start_ms: int = Field(gt=0)
+    end_ms: int = Field(gt=0)
+
+
+class BenchmarkSuite(BaseModel):
+    cases: List[BenchmarkFrame] = Field(min_length=1, max_length=6)
+    repeats: int = Field(default=2, ge=1, le=4)
+    paired_prefill: bool = False
+    paired_order: str = 'ABBA'
+    queries: List[str] = Field(default_factory=list, max_length=2)
+
+
+@router.post('/benchmark/run')
+def benchmark_run(payload: BenchmarkSuite):
+    if os.environ.get('WORLDSENSE_ENABLE_BENCHMARK') != '1':
+        raise HTTPException(404, 'Recorded-frame benchmarking is disabled')
+    if payload.paired_order not in ('ABBA', 'BAAB'):
+        raise HTTPException(400, 'Paired order must be ABBA or BAAB')
+    if payload.paired_prefill and payload.repeats not in (2, 4):
+        raise HTTPException(400, 'Paired prefill requires 2 or 4 timed repeats per policy')
+    for case in payload.cases:
+        window(case.start_ms, case.end_ms)
+    if any(not query or len(query) > 200 for query in payload.queries):
+        raise HTTPException(400, 'Benchmark queries must contain 1..200 characters')
+    from services.benchmark import recorded_suite
+    try:
+        return recorded_suite(get_timedb_path(), [case.model_dump() for case in payload.cases], payload.repeats, payload.queries, payload.paired_prefill, payload.paired_order)
+    except ValueError as error:
+        raise HTTPException(409, str(error))
+
+
 class Case(BaseModel):
