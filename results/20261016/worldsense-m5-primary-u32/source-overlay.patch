+        q.k0=as_type<ushort4>(lo.xy);q.k1=as_type<ushort4>(lo.zw);
+        q.k2=as_type<ushort4>(hi.xy);q.k3=as_type<ushort4>(hi.zw);
+    }
+    return q;
+}
