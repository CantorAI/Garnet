+void MetalCompiledGraph::RetireResidentDefaults() {
+#ifdef GARNET_METAL_LAZY_RESIDENT_DEFAULTS
+    if(!lazyDefaultPlanReady_) {
+        if(!ready_||outputParts_.size()!=3||inputs_.size()<3||residentOps_.size()!=ops_.size())return;
