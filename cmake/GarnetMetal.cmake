# Native MPS kernels, with optional captured Qwen xModel package integration.
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_OBJCXX_STANDARD 17)
set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
find_library(GARNET_METAL_FRAMEWORK Metal REQUIRED)
find_library(GARNET_MPS_FRAMEWORK MetalPerformanceShaders REQUIRED)
find_library(GARNET_FOUNDATION_FRAMEWORK Foundation REQUIRED)
add_library(garnet_metal STATIC src/backends/metal/metal_context.mm)
option(GARNET_METAL_SERIAL_VISION_PREFETCH "Prefetch original-order FP32 vision value contractions" OFF)
if(GARNET_METAL_SERIAL_VISION_PREFETCH)
    if(GARNET_METAL_FUSED_VISION_CONTEXT OR GARNET_METAL_PARALLEL_VISION_CONTEXT)
        message(FATAL_ERROR "Serial vision prefetch is a separate value-contraction policy")
    endif()
    target_compile_definitions(garnet_metal PUBLIC GARNET_METAL_SERIAL_VISION_PREFETCH=1)
endif()
option(GARNET_METAL_SCREENED_HEAD "Test bounded strict-math screening with original greedy-head refinement" OFF)
