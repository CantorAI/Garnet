{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garnet.local/workbench/graph.schema.json",
  "title": "Garnet Workbench Graph",
  "type": "object",
  "required": ["schema_version", "model", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "required": ["name", "family", "source"],
      "properties": {
        "name": { "type": "string" },
        "family": { "type": "string" },
        "source": { "type": "string" },
        "config": { "type": "object" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "label", "status"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["model", "block", "op", "tensor", "matrix", "cache", "runtime"]
        },
        "label": { "type": "string" },
        "op": { "type": "string" },
        "backend": {
          "type": "string",
          "enum": ["native", "trt", "cuda", "plugin", "debug", "missing", "unknown", "mismatch"]
        },
        "status": {
          "type": "string",
          "enum": ["defined", "supported", "missing", "unknown", "mismatch", "planned"]
        },
        "source": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "function": { "type": "string" },
            "line": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "shape": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "outputs": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "tensor": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
