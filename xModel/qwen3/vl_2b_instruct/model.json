{
  "schema_version": 1,
  "id": "Qwen3-VL-2B-Instruct",
  "slug": "qwen3-vl-2b-instruct",
  "display_name": "Qwen3-VL-2B-Instruct",
  "family": "qwen3-vl",
  "task": "image-text-to-text",
  "capabilities": {
    "text": true,
    "vision": true,
    "paged_kv_cache": true,
    "continuous_batching_graph": true
  },
  "entrypoints": {
    "model": {
      "file": "qwen_vl_model.x",
      "function": "Qwen3VLModel",
      "frontend": "qwen3_vl"
    },
    "prefill": {
      "file": "qwen_vl_prefill.x",
      "function": "Qwen3VLPrefill",
      "frontend": "qwen3_vl"
    },
    "decode": {
      "file": "qwen_text_decode.x",
      "function": "Qwen3TextDecode",
      "frontend": "qwen3_vl"
    },
    "decode_batch": {
      "file": "qwen_text_decode_batch.x",
      "function": "Qwen3TextDecodeBatch",
      "frontend": "qwen3_vl"
    }
  },
  "profile_files": [
    "profiles/tensorrt_bf16.json"
  ],
  "serving_profiles": [
    {
      "id": "vision-fast",
      "usage": "chat",
      "maxInputTokens": 512,
      "maxOutputTokens": 128,
      "kvPages": 128,
      "vision": {
        "imageResolution": "320x192"
      }
    },
    {
      "id": "vision-balanced",
      "usage": "vision",
      "default": true,
      "maxInputTokens": 1536,
      "maxOutputTokens": 256,
      "kvPages": 128,
      "vision": {
        "imageResolution": "1920x1080"
      }
    },
    {
      "id": "vision-detailed",
      "usages": ["vision", "agent"],
      "maxInputTokens": 1536,
      "maxOutputTokens": 512,
      "kvPages": 160,
      "vision": {
        "imageResolution": "1920x1080"
      }
    }
  ],
  "weights": {
    "bundled": false,
    "format": "safetensors",
    "source": "Qwen/Qwen3-VL-2B-Instruct",
    "config_file": "config.json",
    "tokenizer_file": "tokenizer.json"
  }
}
