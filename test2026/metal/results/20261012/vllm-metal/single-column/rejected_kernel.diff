+// One output column per SIMD group reduces live accumulators and avoids the
+// four-column weight transpose. Batch specialization removes unused row work.
+template<uint Rows>
+inline void bf16_decode_one(device const float* a,device const ushort* weight,device float* out,
+    constant BF16Params& p,uint group,uint simd,uint lane) {
+    ulong column=ulong(group)*4+simd;if(column>=p.columns)return;
+    float sum0=0.0f,sum1=0.0f;
+    device const ushort* row=weight+column*p.inner;
+    for(ulong k=ulong(lane)*4;k<p.inner;k+=128) {
+        float4 w=as_type<float4>(uint4(*(device const ushort4*)(row+k))<<16);
+        float4 x=*(device const float4*)(a+k);sum0+=dot(x,w);
+        if(Rows==2){float4 y=*(device const float4*)(a+p.aStride+k);sum1+=dot(y,w);}
+    }
+    sum0=simd_sum(sum0);if(Rows==2)sum1=simd_sum(sum1);
+    if(lane==0){out[column]=sum0;if(Rows==2)out[p.oStride+column]=sum1;}
+}
+kernel void bf16_decode_one1(device const float* a [[buffer(0)]],device const ushort* weight [[buffer(1)]],
+    device float* out [[buffer(2)]],constant BF16Params& p [[buffer(3)]],
+    uint group [[threadgroup_position_in_grid]],uint simd [[simdgroup_index_in_threadgroup]],uint lane [[thread_index_in_simdgroup]]) {
+    bf16_decode_one<1>(a,weight,out,p,group,simd,lane);
+}
