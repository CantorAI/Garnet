 }
+struct HalfDecodeParams {ulong rows,inner,columns,aStride,oStride,wStride;};
+kernel void exact_half_decode(device const float* a [[buffer(0)]],device const half* weight [[buffer(1)]],
+    device float* out [[buffer(2)]],constant HalfDecodeParams& p [[buffer(3)]],device const int* scales [[buffer(4)]],
+    uint group [[threadgroup_position_in_grid]],uint simd [[simdgroup_index_in_threadgroup]],uint lane [[thread_index_in_simdgroup]]) {
+    ulong column=ulong(group)*16+simd*4;
+    if(column>=p.columns)return;
+    float4 sum0=0.0f,sum1=0.0f;
+    if(p.inner%4==0) {
+        for(ulong k=ulong(lane)*4;k<p.inner;k+=128) {
+            float4 x=*(device const float4*)(a+k),y=p.rows==2?*(device const float4*)(a+p.aStride+k):float4(0.0f);
+            half4 b0=*(device const half4*)(weight+column*p.wStride+k),b1=half4(0),b2=half4(0),b3=half4(0);
+            if(column+1<p.columns)b1=*(device const half4*)(weight+(column+1)*p.wStride+k);
+            if(column+2<p.columns)b2=*(device const half4*)(weight+(column+2)*p.wStride+k);
+            if(column+3<p.columns)b3=*(device const half4*)(weight+(column+3)*p.wStride+k);
+            for(uint j=0;j<4;++j) {
+                float4 w=float4(b0[j],b1[j],b2[j],b3[j]);
+                sum0+=x[j]*w;if(p.rows==2)sum1+=y[j]*w;
+            }
+        }
+    } else {
+    for(ulong k=lane;k<p.inner;k+=32) {
+        float x=a[k],y=p.rows==2?a[p.aStride+k]:0.0f;
+        float4 w=0.0f;
+        w.x=float(weight[column*p.wStride+k]);
+        if(column+1<p.columns)w.y=float(weight[(column+1)*p.wStride+k]);
+        if(column+2<p.columns)w.z=float(weight[(column+2)*p.wStride+k]);
+        if(column+3<p.columns)w.w=float(weight[(column+3)*p.wStride+k]);
+        sum0+=x*w;if(p.rows==2)sum1+=y*w;
+    }
+    }
+    sum0=float4(simd_sum(sum0.x),simd_sum(sum0.y),simd_sum(sum0.z),simd_sum(sum0.w));
+    sum1=float4(simd_sum(sum1.x),simd_sum(sum1.y),simd_sum(sum1.z),simd_sum(sum1.w));
+    if(lane==0)for(uint j=0;j<4&&column+j<p.columns;++j){out[column+j]=ldexp(sum0[j],-scales[column+j]);if(p.rows==2)out[p.oStride+column+j]=ldexp(sum1[j],-scales[column+j]);}
+}
