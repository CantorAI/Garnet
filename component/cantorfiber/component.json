{
  "schemaVersion": 1,
  "id": "cantorai.garnet",
  "displayName": "Garnet Local Inference",
  "description": "Native Garnet model-serving component for CantorFiber.",
  "version": "0.1.0",
  "runtime": {
    "kind": "process",
    "entrypoint": "GarnetServ.exe",
    "args": [],
    "ipc": {
      "kind": "stdio-jsonl",
      "protocol": "cantorfiber-component-ipc-v1",
      "note": "Use the same supervised process IPC slot as the ASR component."
    },
    "environment": {
      "GARNET_AUTO_INSTALL": "1",
      "GARNET_DATA_ROOT": "${componentData}/garnet"
    }
  },
  "xlang": {
    "enabled": true,
    "module": "garnet",
    "python": false,
    "loadMode": "native-package"
  },
  "packageResolution": {
    "authority": "manifold",
    "catalog": {
      "kind": "cantorai.package-catalog-v2",
      "channel": "${channel}",
      "url": "${manifold}/api/v1/packages/catalogs/${channel}",
      "signatureUrl": "${manifold}/api/v1/packages/catalogs/${channel}.sig"
    },
    "artifactPlane": "github-releases",
    "rules": [
      {
        "id": "cantorai.xlang-runtime",
        "version": "*",
        "required": true,
        "reason": "GarnetServ loads Garnet through the native XLang engine."
      },
      {
        "id": "cantorai.garnet-runtime",
        "version": "*",
        "required": true,
        "reason": "provides garnet.dll and native XLang runtime files."
      }
    ],
    "modelSelection": {
      "source": "request.body.model",
      "packageKind": "content",
      "requiresProvide": "garnet.model/${model}",
      "installRootEnv": "GARNET_MODEL_INSTALL_ROOT",
      "cacheRootEnv": "GARNET_MODEL_CACHE_ROOT"
    },
    "optionalAcceleration": {
      "source": "hardware-detected",
      "packageKind": "runtime",
      "requiresProvide": "garnet.acceleration/*",
      "installRootEnv": "GARNET_ACCELERATION_INSTALL_ROOT",
      "cacheRootEnv": "GARNET_ACCELERATION_CACHE_ROOT"
    },
    "activationInputs": [
      {
        "name": "GARNET_XLANG_DIR",
        "from": "package:cantorai.xlang-runtime:bin"
      },
      {
        "name": "GARNET_MODEL_INSTALL_ROOT",
        "from": "content:garnet-models:root"
      },
      {
        "name": "GARNET_MODEL_CACHE_ROOT",
        "from": "content:garnet-models:cache"
      }
    ]
  },
  "apis": [
    {
      "id": "garnet.health",
      "method": "GET",
      "path": "component:/v1/health",
      "schema": "schemas/health.schema.json"
    },
    {
      "id": "garnet.models",
      "method": "GET",
      "path": "component:/v1/models",
      "schema": "schemas/models.schema.json"
    },
    {
      "id": "garnet.chat.completions",
      "method": "POST",
      "path": "component:/v1/chat/completions",
      "schema": "schemas/chat-completions.schema.json"
    },
    {
      "id": "garnet.responses",
      "method": "POST",
      "path": "component:/v1/responses",
      "schema": "schemas/responses.schema.json"
    },
    {
      "id": "garnet.audio.speech",
      "method": "POST",
      "path": "component:/v1/audio/speech",
      "schema": "schemas/audio-speech.schema.json"
    },
    {
      "id": "garnet.audio.transcriptions",
      "method": "POST",
      "path": "component:/v1/audio/transcriptions",
      "schema": "schemas/audio-transcriptions.schema.json"
    },
    {
      "id": "garnet.images.describe",
      "method": "POST",
      "path": "component:/v1/images/describe",
      "schema": "schemas/images-describe.schema.json"
    }
  ]
}
