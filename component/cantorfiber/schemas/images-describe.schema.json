{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Garnet Image Description",
  "type": "object",
  "required": ["image_path"],
  "properties": {
    "model": { "type": "string" },
    "image_path": { "type": "string" },
    "prompt": { "type": "string", "default": "Describe this image." },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 32768, "default": 4096 },
    "profile": { "type": "object", "additionalProperties": true },
    "garnet_profile": { "type": "object", "additionalProperties": true },
    "serve_options": { "type": "object", "additionalProperties": true }
  }
}

