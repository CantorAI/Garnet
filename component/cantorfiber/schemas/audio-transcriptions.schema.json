{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Garnet Audio Transcriptions",
  "type": "object",
  "required": ["model", "file"],
  "properties": {
    "model": { "type": "string" },
    "file": { "type": "string" },
    "audio_path": { "type": "string" },
    "prompt": { "type": "string" },
    "language": { "type": "string", "default": "English" },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 256 }
  }
}
